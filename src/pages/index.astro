---

<Layout title="Zidan Omar Hamid — Software Engineer">
    <div class="page">
        <SiteHeader />
        <SectionNav />
        <Landing company={experiences[0].company} />
        <ExperienceSection experiences={experiences} />
        <ProjectsSection projects={projects} />
        <EducationSection educations={educations} />
        <ContactSection contacts={contacts} />
        <Footer />
    </div>
</Layout>

<style>
.page {
    min-height: 100vh;
}
</style>

<script>
    const SECTION_IDS = ['home', 'experience', 'projects', 'education', 'contact'];
    const dotLinks = document.querySelectorAll<HTMLElement>('.dot-link');

    function updateDots() {
        let current = 'home';
        for (const id of SECTION_IDS) {
            const el = document.getElementById(id);
            if (el && el.getBoundingClientRect().top <= window.innerHeight * 0.5) {
                current = id;
            }
        }
        dotLinks.forEach(link => {
            const dot = link.querySelector('.dot');
            if (dot) {
                dot.classList.toggle('active', link.dataset.section === current);
            }
        });
    }

    window.addEventListener('scroll', updateDots, { passive: true });
    updateDots();

    const observer = new IntersectionObserver(
        entries => entries.forEach(e => { if (e.isIntersecting) e.target.classList.add('visible'); }),
        { threshold: 0.1 }
    );

    document.querySelectorAll('.tl-reveal').forEach(el => observer.observe(el));
</script>
