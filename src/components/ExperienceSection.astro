---
interface Experience {
    year: string;
    company: string;
    role: string;
    tags: string[];
    work: string[];
    location: {
        city: string,
        country: string
    }
}

interface Props {
    experiences: Experience[];
}

const { experiences } = Astro.props;
---
<section id="experience" class="section section--experience">
    <div class="section-inner">
        <h2 class="section-heading">experience</h2>

        <div class="timeline">
            {experiences.map((exp, i) => (
                <article class:list={["tl-entry", "tl-reveal", "tl-reveal--from-left", { "tl-entry--last": i === experiences.length - 1 }]} style={`transition-delay: ${i * 80}ms`}>
                    <div class="tl-left">
                        <span class="tl-year">{exp.year}</span>
                        {i===0 && <span class="tl-present">now</span>}
                    </div>
                    <div class="tl-spine">
                        <div class="tl-dot"></div>
                    </div>
                    <div class="tl-body">
                        <div class="tl-header">
                            <div class="tl-title-row">
                                <h3 class="tl-company">{exp.company}</h3>
                                {exp.location && <span class="tl-location">{exp.location.city}, {exp.location.country}</span>}
                            </div>
                            <span class="tl-role">{exp.role}</span>
                        </div>
                        {exp.tags.length > 0 && (
                            <div class="tl-tags">
                                {exp.tags.map(tag => <span>{tag}</span>)}
                            </div>
                        )}
                        <ul class="tl-work">
                            {exp.work.map(item => <li>{item}</li>)}
                        </ul>
                    </div>
                </article>
            ))}
        </div>
    </div>
</section>

<style>
/* Timeline */
.timeline {
    display: flex;
    flex-direction: column;
}

.tl-entry {
    display: grid;
    grid-template-columns: 44px 20px 1fr;
}

.tl-left {
    display: flex;
    flex-direction: column;
    align-items: flex-end;
    padding-right: 0.75rem;
    padding-top: 0.4rem;
}

.tl-year {
    font-size: 0.8rem;
    color: var(--text-accent);
    letter-spacing: 0.04em;
    line-height: 1;
}

.tl-present {
    font-size: 0.65rem;
    color: var(--string-color);
    margin-top: 4px;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    font-weight: 500;
}

.tl-spine {
    display: flex;
    flex-direction: column;
    align-items: center;
    padding-top: 0.4rem;
    position: relative;
}

.tl-entry:not(.tl-entry--last) .tl-spine::before {
    content: '';
    position: absolute;
    top: 0;
    bottom: 0;
    left: 50%;
    transform: translateX(-50%);
    width: 1px;
    background: var(--border-color);
}

.tl-dot {
    width: 7px;
    height: 7px;
    border-radius: 50%;
    background: var(--accent-color);
    border: 2px solid var(--bg-primary);
    box-shadow: 0 0 0 1px var(--accent-color);
    flex-shrink: 0;
    position: relative;
    z-index: 1;
    transition: box-shadow 0.2s ease;
}

.tl-entry:hover .tl-dot {
    box-shadow: 0 0 0 1px var(--accent-color), 0 0 8px color-mix(in srgb, var(--accent-color) 40%, transparent);
}

.tl-body {
    padding-left: 1.25rem;
    padding-bottom: 3rem;
}

.tl-entry--last > .tl-body {
    padding-bottom: 0;
}

.tl-header {
    display: flex;
    flex-direction: column;
    gap: 0.25rem;
    margin-bottom: 0.75rem;
}

.tl-company {
    font-size: 1rem;
    font-weight: 600;
    color: var(--text-primary);
    transition: color 0.15s ease;
}

.tl-entry:hover .tl-company {
    color: var(--text-accent);
}

.tl-role {
    font-size: 0.8rem;
    color: var(--text-accent);
    font-weight: 400;
    letter-spacing: 0.03em;
    opacity: 0.8;
}

.tl-title-row {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: 1rem;
}

.tl-location {
    font-size: 0.8rem;
    color: var(--comment-color);
    letter-spacing: 0.02em;
    flex-shrink: 0;
}

.tl-tags {
    display: flex;
    gap: 0.375rem;
    flex-wrap: wrap;
    margin-bottom: 0.875rem;
}

.tl-tags span {
    font-size: 0.7rem;
    color: var(--text-primary);
    opacity: 0.6;
    border: 1px solid color-mix(in srgb, var(--border-color) 80%, var(--text-secondary));
    padding: 2px 8px;
    border-radius: 3px;
    transition: border-color 0.15s ease, color 0.15s ease, opacity 0.15s ease;
    letter-spacing: 0.02em;
}

.tl-tags span:hover {
    border-color: var(--accent-color);
    color: var(--text-accent);
    opacity: 1;
}

.tl-work {
    list-style: none;
    padding: 0;
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
}

.tl-work li {
    font-size: 0.9rem;
    color: var(--text-primary);
    opacity: 0.85;
    line-height: 1.75;
    padding-left: 1rem;
    position: relative;
}

.tl-work li::before {
    content: '·';
    position: absolute;
    left: 0;
    color: var(--accent-color);
    opacity: 0.4;
    transition: opacity 0.15s ease;
}

.tl-entry:hover .tl-work li::before {
    opacity: 1;
}

@media (max-width: 768px) {
    .tl-entry {
        grid-template-columns: 36px 1fr;
    }

    .tl-spine {
        display: none;
    }

    .tl-left {
        grid-column: 1;
        grid-row: 1;
        padding-right: 0.5rem;
    }

    .tl-body {
        grid-column: 2;
        grid-row: 1;
        padding-left: 0.75rem;
        border-left: 1px solid var(--border-color);
        padding-bottom: 2.5rem;
    }

    .tl-entry--last > .tl-body {
        border-left-color: transparent;
    }

    .tl-title-row {
        flex-direction: column-reverse;
        align-items: flex-start;
        gap: 0.25rem;
    }

    .tl-location {
        order: 1;
        margin-top: 0.5rem;
    }
}
</style>
