---
interface Education {
    year: string;
    school: string;
    location: string;
    major: string;
}

interface Props {
    educations: Education[];
}

const { educations } = Astro.props;
---
<section id="education" class="section section--education">
    <div class="section-inner">
        <h2 class="section-heading tl-reveal">education</h2>

        <div class="edu-list">
            {educations.map((edu, i) => (
                <div class="edu-item tl-reveal" style={`transition-delay: ${i * 80}ms`}>
                    <div class="edu-header">
                        <span class="edu-school">{edu.school}</span>
                        <span class="edu-year">{edu.year}</span>
                    </div>
                    <div class="edu-meta">
                        <span class="edu-major">{edu.major}</span>
                         <span class="edu-location">{edu.location}</span>
                    </div>
                </div>
            ))}
        </div>
    </div>
</section>

<style>
.section--education {
    border-top: 1px solid var(--border-color);
}

.edu-list {
    display: flex;
    flex-direction: column;
    gap: 1.25rem;
}

.edu-item {
    display: flex;
    flex-direction: column;
    gap: 0.25rem;
    padding-left: 0.875rem;
    border-left: 2px solid var(--border-color);
    transition:
        border-color 0.2s ease,
        opacity 0.55s cubic-bezier(0.25, 0.46, 0.45, 0.94),
        transform 0.55s cubic-bezier(0.25, 0.46, 0.45, 0.94);
}

.edu-item:hover {
    border-left-color: var(--accent-color);
}

.edu-header {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: 1rem;
}

.edu-school {
    font-size: 1rem;
    color: var(--text-primary);
    font-weight: 500;
}

.edu-year {
    font-size: 0.8rem;
    color: var(--text-accent);
    letter-spacing: 0.04em;
    flex-shrink: 0;
}

.edu-meta {
    display: flex;
    align-items: center;
    gap: 0.5rem;
}

.edu-major {
    font-size: 0.875rem;
    color: var(--text-secondary);
}

.edu-location {
    font-size: 0.8rem;
    color: var(--text-secondary);
    opacity: 0.6;
}

.edu-location::before {
    content: "·";
    margin-right: 0.5rem;
}
</style>
