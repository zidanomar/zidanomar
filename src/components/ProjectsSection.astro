---
interface Project {
    name: string;
    subtitle: string;
    kind: string;
    tags: string[];
    work: string[];
    href?: string;
}

interface Props {
    projects: Project[];
}

const { projects } = Astro.props;

const slug = (s: string) => s.toLowerCase().replace(/[^a-z0-9]+/g, '-').replace(/^-|-$/g, '');
---
<section id="projects" class="section section--projects">
    <div class="section-inner">
        <h2 class="section-heading tl-reveal">projects</h2>

        <div class="projects">
            {projects.map((proj, i) => {
                const isLink = Boolean(proj.href);
                const Tag = isLink ? 'a' : 'article';
                const linkAttrs = isLink
                    ? { href: proj.href, target: '_blank', rel: 'noopener' }
                    : {};
                return (
                    <Tag
                        class:list={["proj-card", "tl-reveal", "tl-reveal--from-left", { "proj-card--link": isLink }]}
                        style={`transition-delay: ${i * 90}ms`}
                        {...linkAttrs}
                    >
                        <header class="proj-chrome">
                            <div class="proj-dots" aria-hidden="true">
                                <span class="proj-dot proj-dot--r"></span>
                                <span class="proj-dot proj-dot--y"></span>
                                <span class="proj-dot proj-dot--g"></span>
                            </div>

                            <div class="proj-tab">
                                <span class="proj-tab-icon" aria-hidden="true"></span>
                                <span class="proj-tab-name">{slug(proj.name)}</span>
                                <span class="proj-tab-ext">.md</span>
                            </div>

                            <div class="proj-meta">
                                <span class="proj-kind-dot" aria-hidden="true"></span>
                                <span class="proj-kind">{proj.kind}</span>
                            </div>
                        </header>

                        <div class="proj-content">
                            <h3 class="proj-title">
                                {proj.name}
                                {isLink && <span class="proj-arrow" aria-hidden="true">↗</span>}
                            </h3>
                            <p class="proj-subtitle">{proj.subtitle}</p>

                            {proj.tags.length > 0 && (
                                <div class="proj-tags">
                                    {proj.tags.map(tag => <span>{tag}</span>)}
                                </div>
                            )}

                            <ul class="proj-work">
                                {proj.work.map(item => <li>{item}</li>)}
                            </ul>
                        </div>
                    </Tag>
                );
            })}
        </div>
    </div>
</section>

<style>
.section--projects {
    border-top: 1px solid var(--border-color);
}

.projects {
    display: flex;
    flex-direction: column;
    gap: 1.75rem;
}

/* ── Card (editor window) ── */
.proj-card {
    position: relative;
    display: block;
    border: 1px solid var(--border-color);
    border-radius: 6px;
    background: var(--bg-secondary);
    overflow: hidden;
    color: inherit;
    text-decoration: none;
    box-shadow:
        0 1px 0 color-mix(in srgb, var(--accent-color) 8%, transparent),
        0 8px 24px -12px rgba(0, 0, 0, 0.35);
    transition:
        border-color 0.25s ease,
        box-shadow 0.25s ease,
        transform 0.25s ease,
        opacity 0.55s cubic-bezier(0.25, 0.46, 0.45, 0.94);
}

.proj-card::before {
    content: '';
    position: absolute;
    inset: 0;
    pointer-events: none;
    background: linear-gradient(
        135deg,
        color-mix(in srgb, var(--accent-color) 6%, transparent) 0%,
        transparent 40%
    );
    opacity: 0;
    transition: opacity 0.3s ease;
}

.proj-card--link:hover {
    transform: translateY(-2px);
    border-color: color-mix(in srgb, var(--accent-color) 55%, var(--border-color));
    box-shadow:
        0 1px 0 color-mix(in srgb, var(--accent-color) 30%, transparent),
        0 16px 36px -16px color-mix(in srgb, var(--accent-color) 35%, rgba(0, 0, 0, 0.5));
}

.proj-card:hover::before {
    opacity: 1;
}

/* ── Chrome / title bar ── */
.proj-chrome {
    display: grid;
    grid-template-columns: auto 1fr auto;
    align-items: center;
    gap: 0.9rem;
    padding: 0 0.85rem;
    height: 34px;
    background: var(--bg-primary);
    border-bottom: 1px solid var(--border-color);
    position: relative;
}

.proj-dots {
    display: flex;
    gap: 6px;
}

.proj-dot {
    width: 10px;
    height: 10px;
    border-radius: 50%;
    background: var(--border-color);
    transition: background 0.2s ease;
}

.proj-card:hover .proj-dot--r { background: #ff5f57; }
.proj-card:hover .proj-dot--y { background: #febc2e; }
.proj-card:hover .proj-dot--g { background: #28c840; }

/* Active-tab pill */
.proj-tab {
    display: inline-flex;
    align-items: center;
    justify-self: start;
    height: 100%;
    padding: 0 0.75rem;
    font-size: 0.72rem;
    background: var(--bg-secondary);
    border-left: 1px solid var(--border-color);
    border-right: 1px solid var(--border-color);
    position: relative;
    color: var(--text-primary);
    letter-spacing: 0.01em;
}

.proj-tab::before {
    content: '';
    position: absolute;
    left: 0;
    right: 0;
    top: 0;
    height: 2px;
    background: var(--accent-color);
    opacity: 0.7;
    transition: opacity 0.2s ease;
}

.proj-card:hover .proj-tab::before {
    opacity: 1;
}

.proj-tab::after {
    content: '';
    position: absolute;
    left: 0;
    right: 0;
    bottom: -1px;
    height: 1px;
    background: var(--bg-secondary);
}

.proj-tab-icon {
    width: 8px;
    height: 8px;
    margin-right: 0.45rem;
    border-radius: 2px;
    background: var(--accent-color);
    flex-shrink: 0;
    box-shadow: 0 0 6px color-mix(in srgb, var(--accent-color) 50%, transparent);
}

.proj-tab-name {
    color: var(--text-primary);
}

.proj-tab-ext {
    color: var(--comment-color);
}

/* Right meta: kind indicator */
.proj-meta {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    font-size: 0.6rem;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--text-secondary);
}

.proj-kind-dot {
    width: 6px;
    height: 6px;
    border-radius: 50%;
    background: var(--string-color);
    box-shadow: 0 0 0 3px color-mix(in srgb, var(--string-color) 18%, transparent);
}

.proj-kind {
    color: var(--text-secondary);
    transition: color 0.2s ease;
}

.proj-card:hover .proj-kind {
    color: var(--text-primary);
}

/* ── Content ── */
.proj-content {
    padding: 1.25rem 1.25rem 1.25rem;
    position: relative;
    z-index: 1;
}

.proj-title {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    font-size: 1rem;
    font-weight: 600;
    color: var(--text-primary);
    letter-spacing: -0.005em;
    line-height: 1.3;
    margin-bottom: 0.35rem;
    transition: color 0.15s ease;
}

.proj-card--link:hover .proj-title {
    color: var(--text-accent);
}

.proj-arrow {
    font-size: 0.8rem;
    color: var(--accent-color);
    opacity: 0;
    transform: translate(-3px, 2px);
    transition: opacity 0.2s ease, transform 0.2s ease;
}

.proj-card--link:hover .proj-arrow {
    opacity: 1;
    transform: translate(0, 0);
}

.proj-subtitle {
    font-size: 0.75rem;
    color: var(--text-secondary);
    line-height: 1.6;
    margin-bottom: 1rem;
}

.proj-tags {
    display: flex;
    gap: 0.375rem;
    flex-wrap: wrap;
    margin-bottom: 0.875rem;
}

.proj-tags span {
    font-size: 0.625rem;
    color: var(--text-secondary);
    border: 1px solid var(--border-color);
    padding: 2px 8px;
    border-radius: 3px;
    letter-spacing: 0.02em;
    transition: border-color 0.15s ease, color 0.15s ease;
}

.proj-card:hover .proj-tags span {
    border-color: color-mix(in srgb, var(--text-secondary) 60%, var(--border-color));
}

.proj-work {
    list-style: none;
    padding: 0;
    margin: 0;
    display: flex;
    flex-direction: column;
    gap: 0.4rem;
}

.proj-work li {
    font-size: 0.8rem;
    color: var(--text-secondary);
    line-height: 1.7;
    padding-left: 1rem;
    position: relative;
}

.proj-work li::before {
    content: '–';
    position: absolute;
    left: 0;
    color: var(--border-color);
    transition: color 0.15s ease;
}

.proj-card:hover .proj-work li::before {
    color: var(--text-secondary);
}

@media (max-width: 768px) {
    .proj-chrome {
        padding: 0 0.65rem;
        gap: 0.6rem;
        height: 32px;
    }

    .proj-tab {
        padding: 0 0.6rem;
        font-size: 0.68rem;
    }

    .proj-meta {
        font-size: 0.55rem;
        letter-spacing: 0.1em;
    }

    .proj-content {
        padding: 1rem;
    }

    .proj-title {
        font-size: 0.95rem;
    }
}

@media (max-width: 480px) {
    .proj-meta {
        display: none;
    }

    .proj-chrome {
        grid-template-columns: auto 1fr;
    }
}
</style>
